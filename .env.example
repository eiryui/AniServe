# Required. Where the catalogue lives. AniServe opens it read-only. Pick ONE form:
#   PostgreSQL  postgresql://user:password@host:5432/dbname      (add ?sslmode=require for hosted databases)
#   SQLite      sqlite:///data/anilist.sqlite                    (three slashes + relative path, four + absolute)
#   DuckDB      duckdb:///data/anilist.duckdb
#   Parquet     parquet:///data/parquet                          (the folder you unzipped the -parquet.zip into)
# A bare path also works: data/anilist.sqlite, data/anilist.duckdb, data/parquet
DATABASE_URL=sqlite:///data/anilist.sqlite

# PostgreSQL only: the schema the tables were restored into, if it is not on the search_path.
# ANISERVE_SCHEMA=public

# DuckDB and Parquet only: "memory" (default) loads the data into RAM at startup, which is several times faster;
# "disk" reads the files in place and needs little RAM. Memory mode holds the whole catalogue in RAM: expect a few
# hundred MB for the real dump (estimated from its 153 MB size; measure on your host). Disk mode is 5 to 10 times slower per query.
# ANISERVE_DUCKDB_MODE=memory

# Port for the Docker image. With plain uvicorn pass --port instead.
PORT=8002

# Comma-separated CORS origins. Credentials are never sent, so * is safe for a public read-only API.
ALLOWED_ORIGINS=*

# Per-client request limit. RPM 0 turns it off. Enable TRUST_PROXY only behind a trusted reverse proxy.
API_RATE_LIMIT_RPM=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_TRUST_PROXY=false

# true: every route returns exactly the fields Miruro's live-AniList route returns.
# false: keep the richer stored fields (cover colours, isAdult on related titles, updatedAt, ...).
API_STRICT_MIRURO_SHAPE=true

# GET /export streams the whole catalogue. Set false to switch it off on a public deployment.
ANISERVE_ENABLE_EXPORT=true

# Longest a single query may run on PostgreSQL, in milliseconds.
ANISERVE_STATEMENT_TIMEOUT_MS=30000

# PostgreSQL connections (minimum 2) and worker threads for blocking queries.
DATABASE_POOL_SIZE=10
THREAD_POOL_SIZE=32
