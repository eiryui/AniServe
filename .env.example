# AniServe reads a PostgreSQL database that already holds the AniList tables (anilist_catalog, anilist_detail_pages), as filled by
# the AniList database dump. It never writes to it. Any PostgreSQL 12+ works; to prepare an empty database run: psql "$DATABASE_URL" -f schema.sql
#   Local:           postgresql://postgres:postgres@localhost:5432/anilist_index
#   Neon:            postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
#   Aiven:           postgres://avnadmin:PASSWORD@pg-xxxx-PROJECT.a.aivencloud.com:PORT/defaultdb?sslmode=require   (free plan: max_connections=20)
#   Prisma Postgres: connection string from the Prisma Console (keep sslmode=require)
# A read-only database role is enough, and a read replica works.
DATABASE_URL=postgresql://user:password@host:5432/anilist_index
ALLOWED_ORIGINS=*
PORT=8001

# Use production for minimal operational responses. In development, /health
# includes catalog diagnostics and application errors are written to logs/error.txt.
APP_ENVIRONMENT=production

# Per-client API limit. RPM is converted to the selected fixed window
# (e.g. 120 RPM + 10 s window = 20 requests per window). Set RPM to 0 to
# disable it. Enable TRUST_PROXY only behind a trusted reverse proxy
# (on Render, Fly, Railway and similar hosts you need it, otherwise every client shares one bucket).
API_RATE_LIMIT_RPM=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_TRUST_PROXY=false

# Max Postgres connections held by the API (minimum 2). Keep it below your database plan's connection limit.
DATABASE_POOL_SIZE=10

# Worker threads for blocking database work.
THREAD_POOL_SIZE=32

# true (default): every route returns exactly the fields Miruro's live-AniList route returns.
# false: keep the richer stored fields (cover colors, isAdult on related titles, updatedAt, ...).
API_STRICT_MIRURO_SHAPE=true
